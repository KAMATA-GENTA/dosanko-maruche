<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.ReviewMapper">

    <resultMap id="reviewMap" type="com.example.demo.entity.Review">
        <id property="reviewId" column="id" />
        <result property="productId" column="product_id" />
        <result property="userId" column="user_id" />
        <result property="rating" column="rating" />
        <result property="comment" column="comment" />
        <result property="createdAt" column="created_at" />
    </resultMap>

    <!-- 平均評価取得：小数第2位以下を切り捨てて、小数第1位まで返す -->
    <select id="findAverageRating"
            parameterType="int"
            resultType="double">

        SELECT COALESCE(TRUNC(AVG(rating)::numeric, 1), 0)
        FROM reviews
        WHERE product_id = #{productId}

    </select>

    <!-- レビュー一覧取得 -->
    <select id="findByProduct"
            parameterType="int"
            resultMap="reviewMap">

        SELECT
            id,
            product_id,
            user_id,
            rating,
            comment,
            created_at
        FROM reviews
        WHERE product_id = #{productId}
        ORDER BY created_at DESC

    </select>

    <!-- レビュー投稿：新規レビューをDBのreviewsテーブルに登録する -->
    <insert id="insert"
            parameterType="com.example.demo.entity.Review"
            useGeneratedKeys="true"
            keyProperty="reviewId"
            keyColumn="id">

        INSERT INTO reviews (
            product_id,
            user_id,
            rating,
            comment,
            created_at
        )
        VALUES (
            #{productId},
            #{userId},
            #{rating},
            #{comment},
            CURRENT_TIMESTAMP
        )

    </insert>

</mapper>
