<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.ReviewMapper">

    <resultMap id="reviewMap" type="com.example.demo.entity.Review">
        <id property="reviewId" column="id"/>
        <result property="productId" column="product_id"/>
        <result property="userId" column="user_id"/>
        <result property="username" column="username"/>
        <result property="rating" column="rating"/>
        <result property="comment" column="comment"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 平均評価取得：小数第2位以下を切り捨てて、小数第1位まで返す -->
    <select id="findAverageRating" parameterType="int" resultType="double">
        SELECT COALESCE(TRUNC(AVG(rating)::numeric, 1), 0)
        FROM reviews
        WHERE product_id = #{productId}
    </select>

    <!--
        レビュー一覧取得。
        usersテーブルとLEFT JOINして、レビュー投稿者のユーザー名も取得する。
        product_idで対象商品を限定し、ratingが指定された場合だけ星の数で絞り込む。
        ORDER BYはMyBatisのchooseで分岐しており、文字列連結を使わないため安全。
    -->
    <select id="findByProduct" resultMap="reviewMap">
        SELECT
            r.id,
            r.product_id,
            r.user_id,
            u.username AS username,
            r.rating,
            r.comment,
            r.created_at
        FROM reviews r
        LEFT JOIN users u
            ON r.user_id = u.id
        WHERE r.product_id = #{productId}

        <if test="rating != null">
            AND r.rating = #{rating}
        </if>

        <choose>
            <when test="sort == 'old'">
                ORDER BY r.created_at ASC, r.id ASC
            </when>
            <when test="sort == 'high'">
                ORDER BY r.rating DESC, r.created_at DESC, r.id DESC
            </when>
            <when test="sort == 'low'">
                ORDER BY r.rating ASC, r.created_at DESC, r.id DESC
            </when>
            <otherwise>
                ORDER BY r.created_at DESC, r.id DESC
            </otherwise>
        </choose>
    </select>

    <!-- レビュー投稿：新規レビューをDBのreviewsテーブルに登録する -->
    <insert id="insert"
            parameterType="com.example.demo.entity.Review"
            useGeneratedKeys="true"
            keyProperty="reviewId"
            keyColumn="id">
        INSERT INTO reviews (
            product_id,
            user_id,
            rating,
            comment,
            created_at
        )
        VALUES (
            #{productId},
            #{userId},
            #{rating},
            #{comment},
            CURRENT_TIMESTAMP
        )
    </insert>

</mapper>