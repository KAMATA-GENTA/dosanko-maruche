<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.OrderMapper">

    <insert id="insert"
            parameterType="com.example.demo.entity.Order"
            useGeneratedKeys="true"
            keyProperty="id">

        INSERT INTO orders
            (user_id, subtotal, shipping_fee, ordered_at)
        VALUES
            (#{userId}, #{subtotal}, #{shippingFee}, CURRENT_TIMESTAMP)

    </insert>

</mapper>